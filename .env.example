# Copia este archivo a .env.local para desarrollo, o configura estas mismas
# variables en Vercel (Project → Settings → Environment Variables).
# Sin estas variables, el sitio funciona igual pero usando data/products.json
# en vez de Google Sheets (ver lib/db.ts).

# --- Google Sheets (inventario) ---
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La cuenta de servicio de Google entrega esta clave con saltos de línea
# reales; al pegarla en Vercel/.env.local escápalos como \n (una sola línea).
GOOGLE_PRIVATE_KEY=

# --- Bot de Telegram ---
TELEGRAM_BOT_TOKEN=
# Cualquier cadena aleatoria larga que tú inventes (ej. genera una en
# https://www.uuidgenerator.net) — valida que los webhooks vengan de Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Chat IDs de Telegram con permiso de usar el bot, separados por coma.
# Sin esto, cualquiera que encuentre el bot puede publicar productos falsos.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Setup de un solo uso (GET /api/admin/setup?secret=...) ---
ADMIN_SETUP_SECRET=

# --- General ---
NEXT_PUBLIC_SITE_URL=https://prelovedmx.vercel.app
